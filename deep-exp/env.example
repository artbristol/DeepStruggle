# Copy to deploy/env.sh and fill in. Sourced by every deploy script.
export WORKSPACE="$HOME/ts"                 # workspace root (logs/, runs/, eval/, anchors/)
export REPO_DIR="$WORKSPACE/DeepStruggle"   # this branch's checkout
export VENV_PY="$WORKSPACE/venv/bin/python" # python with torch installed
export RUN_DIR="$WORKSPACE/runs/E9-A19-R1-S44"
export ANCHORS_DIR="$WORKSPACE/anchors"
export TRAIN_BUDGET=24000000000
export SNAPSHOT_EVERY=20000000
export LADDER_GAMES_PER_SIDE=200
export PYTHONPATH="$REPO_DIR:$REPO_DIR/build/release"
